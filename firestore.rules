rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function isMember(d) { return signedIn() && d.members is map && request.auth.uid in d.members; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function membersChanged() { return request.resource.data.members.diff(resource.data.members).affectedKeys(); }

    // 내 여행 목록 (폰을 바꿔도 여행을 찾아오기 위한 색인) — 본인만
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /trips/{tripId} {
      allow read: if isMember(resource.data);

      // 공유 시작: 만든 사람 혼자만 멤버로
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid]);

      allow update: if signedIn()
        && request.resource.data.owner == resource.data.owner
        && (
          // 만든 사람: 전부 가능 (멤버 내보내기, 링크 새로 만들기 포함)
          request.auth.uid == resource.data.owner
          // 멤버: 내용 수정 + 자기 자신만 나가기, 초대 코드는 못 바꿈
          || (isMember(resource.data)
              && membersChanged().hasOnly([request.auth.uid])
              && !changed().hasAny(['inviteCode', 'owner']))
          // 초대 링크로 참여: 맞는 코드를 들고 자기 자신만 추가
          || (!isMember(resource.data)
              && changed().hasOnly(['members', 'joinWith'])
              && request.resource.data.joinWith == resource.data.inviteCode
              && membersChanged().hasOnly([request.auth.uid])
              && request.auth.uid in request.resource.data.members)
        );

      allow delete: if signedIn() && request.auth.uid == resource.data.owner;

      match /photos/{photoId} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.members;
      }
    }
  }
}
